# AI Expense Tracker - example environment variables.
# Copy to .env (git-ignored) and fill in values. Never commit real values.
# The backend reads these from the process environment (see docs/architecture.md section 3.4 and 5).

# --- Spring profile ---
# dev enables Swagger UI and detailed health output. Leave empty in CI.
SPRING_PROFILES_ACTIVE=dev

# --- Application database (PostgreSQL 16) ---
# In Claude Code Cloud, get real values with: eval "$(scripts/dev-db.sh env)"
DB_URL=jdbc:postgresql://127.0.0.1:5433/aiexpense
DB_USERNAME=aiexpense
DB_PASSWORD=

# --- Test database (used by database and API tests) ---
# Tests fail (they are not skipped) when these are missing.
TEST_DB_URL=jdbc:postgresql://127.0.0.1:5433/aiexpense_test
TEST_DB_USERNAME=aiexpense
TEST_DB_PASSWORD=

# --- Local database script settings (scripts/dev-db.sh) ---
# DEV_DB_PORT=5433
# DEV_DB_STATE_DIR=
# PG_BIN=/usr/lib/postgresql/16/bin

# --- Authentication ---
# At least 32 bytes of random data. Generate with: openssl rand -base64 48
JWT_SECRET=

# --- AI (Anthropic) - backend only, never in the mobile app or CI ---
# Empty key: the app still starts, and the AI endpoint returns 503 AI_UNAVAILABLE.
ANTHROPIC_API_KEY=
# Claude model name to use. Required when ANTHROPIC_API_KEY is set.
AI_MODEL=
# Successful AI insights per user per day (positive integer).
AI_DAILY_LIMIT=5
# How long a quota reservation stays valid (>= 30s, and >= 2 x timeout + 5s).
AI_RESERVATION_TTL=2m
# Timeout for one call to the AI provider.
AI_PROVIDER_TIMEOUT=20s

# --- Mobile app (Expo) ---
# Values prefixed with EXPO_PUBLIC_ are bundled into the app and are NOT secret.
# 127.0.0.1 only works when the app runs on the same machine as the backend
# (iOS simulator, web). Android emulator: http://10.0.2.2:8080/api/v1.
# A real phone needs the backend machine's LAN IP or a public URL (see README).
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
